<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="GitLab.Client">
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <!-- IConfiguration for the appsettings-driven AddGitLabClient overload, and the
         OptionsBuilder<T>.Bind(IConfiguration) extension it uses - see
         GitLabClientServiceCollectionExtensions. Pinned to the same 10.0.12 line as every other
         Microsoft.Extensions.* package above. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="Samples">
    <!-- Only the AOT harness needs a concrete configuration source; the library itself depends solely
         on the Abstractions + Bind() extension above. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <!-- xUnit v3 (package family renamed from "xunit") ships its Microsoft Testing Platform v2
         runner and MSBuild integration. The repository uses MTP natively through global.json. -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup Label="Analyzers">
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401" />
    <!-- Referenced only by src/GitLab.Client, deliberately NOT global: the GitLabJsonContext guard
         test legitimately calls JsonSerializerContext.GetTypeInfo(Type), which BannedSymbols.txt
         bans. 5.6.0 is the newest published version - this package does not track the 5.9.0
         Microsoft.CodeAnalysis.* line below, so "aligning" it to 5.9.0 breaks restore with NU1102. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <!-- Tracks the declared public API surface (PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt) so an
         accidental breaking change or an accidentally-exposed public member is a build error (RS0016/RS0017),
         not a silent diff across ~150 client interfaces and ~1000 DTOs. Same 5.6.0 line as
         BannedApiAnalyzers above - also the newest version published on NuGet.org at time of writing. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
  <ItemGroup Label="SourceGenerators">
    <!-- global.json pins the exact SDK this repo builds with, so the only CS9057 ("newer compiler
         than is currently running") risk is whether that SDK's bundled Roslyn is >= this version -
         verified true for 10.0.400. If global.json's SDK version moves backwards, or the generator
         starts failing to load with CS9057, drop this to the oldest version with the APIs in use
         (AddEmbeddedAttributeDefinition needs >= 4.14.0) rather than chasing latest. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
  </ItemGroup>
</Project>
