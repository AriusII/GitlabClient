<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>GitLab.Client.AotHarness</AssemblyName>
    <RootNamespace>GitLab.Client.AotHarness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <!-- Concrete configuration sources for the appsettings-driven AddGitLabClient(IConfiguration)
         overload; GitLab.Client itself only depends on the Configuration Abstractions. -->
    <PackageReference Include="Microsoft.Extensions.Configuration"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GitLab.Client\GitLab.Client.csproj"/>
    <!--
      The façade is the only NuGet package, which exposes the Contracts and Http assemblies as
      sibling compile assets. ProjectReference does not model those packed sibling assets when
      the façade keeps its implementation references private, so the source sample references
      the two assemblies whose public types it consumes directly.
    -->
    <ProjectReference Include="..\..\src\GitLab.Client.Contracts\GitLab.Client.Contracts.csproj"/>
    <ProjectReference Include="..\..\src\GitLab.Client.Http\GitLab.Client.Http.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

</Project>
