<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The façade is the sole distributable NuGet package. -->
    <IsPackable>true</IsPackable>
    <AssemblyName>GitLab.Client</AssemblyName>
    <RootNamespace>GitLab.Client</RootNamespace>
    <PackageId>GitLab.Client</PackageId>
    <!-- Contracts live in companion assemblies inside this package; retain the 2.0 boundary for
         consumers which compiled against the former monolithic assembly. -->
    <Version>2.0.0</Version>
    <Description>A fully typed, dependency-injection-first C# client for the GitLab REST API v4 and GraphQL API, targeting GitLab 19.x and above. Native AOT and trimming friendly.</Description>
    <PackageTags>gitlab;gitlab-api;rest;graphql;work-items;http-client;aot;native-aot</PackageTags>
    <PackageReadmeFile>README.NuGet.md</PackageReadmeFile>
    <!-- Makes OptionsBuilder<GitLabClientOptions>.Bind(IConfiguration) interceptable by the
         Configuration Binder source generator instead of falling back to reflection - see
         AddGitLabClient(IServiceCollection, IConfiguration, string) in
         GitLabClientServiceCollectionExtensions. Without this, that call is IL2026/IL3050 under
         EnableTrimAnalyzer/EnableAotAnalyzer. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Options"/>
    <!-- IConfiguration for the appsettings-driven AddGitLabClient overload, and the
         OptionsBuilder<GitLabClientOptions>.Bind(IConfiguration) extension it uses. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions"/>
  </ItemGroup>

  <!--
    Bans the Type-based, runtime-resolved System.Text.Json entry points in the façade; the same guard is
    applied by Contracts and Http, where the JSON context and transport live after the project split.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all"/>
    <AdditionalFiles Include="..\BannedSymbols.txt"/>
  </ItemGroup>

  <!--
    Tracks the declared public API surface across releases: RS0016 flags a public member with no
    corresponding PublicAPI.*.txt entry (an accidental breaking change or an accidentally-exposed
    member), RS0017 flags a removed one. Deliberately scoped to this project only - it is the one
    assembly with a public NuGet surface; tests and samples have none to track.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all"/>
    <AdditionalFiles Include="PublicAPI.Shipped.txt"/>
    <AdditionalFiles Include="PublicAPI.Unshipped.txt"/>
  </ItemGroup>

  <PropertyGroup>
    <!--
      RS0026/RS0027 ("do not add multiple public overloads with optional parameters" / "the overload
      with the most parameters should have the optional ones") come bundled with PublicApiAnalyzers
      above but are a different concern from RS0016/RS0017: they flag the "every public async method
      takes a trailing optional-by-default CancellationToken" convention itself (see CLAUDE.md), which
      this library applies deliberately and pervasively across IGitLabApiConnection and every
      I<Resource>Client - e.g. GetAsync<TResponse> vs GetAsync, PostAsync<TRequest,TResponse> vs
      PostAsync<TResponse> vs PostAsync. Those overloads differ in required parameters/arity, not in
      an ambiguous trailing-optional set, so the rule's false-positive rate here is total rather than
      occasional. Suppressed at the same scope PublicApiAnalyzers is added at.
    -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Moving public types into companion assemblies is an intentional 2.0 binary break; do not
         validate their former assembly home in the façade baseline. -->
    <NoWarn>$(NoWarn);RS0017</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GitLab.Client.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      These projects remain compile-time references, while their outputs are embedded alongside
      the façade below. PrivateAssets prevents NuGet from emitting nonexistent GitLab.Client.*
      package dependencies in GitLab.Client.nuspec.
    -->
    <ProjectReference Include="..\GitLab.Client.Contracts\GitLab.Client.Contracts.csproj" PrivateAssets="all"/>
    <ProjectReference Include="..\GitLab.Client.Routing\GitLab.Client.Routing.csproj" PrivateAssets="all"/>
    <ProjectReference Include="..\GitLab.Client.Http\GitLab.Client.Http.csproj" PrivateAssets="all"/>
    <ProjectReference Include="..\..\generators\GitLab.Client.SourceGenerators\GitLab.Client.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.NuGet.md" Pack="true" PackagePath="/"/>
  </ItemGroup>

  <!--
    NuGet's default project-reference behaviour is to create a package dependency. For the three
    internal modules that would require publishing three additional packages. Package the copies
    produced in the façade's resolved output directory instead, placing their runtime assemblies
    and XML documentation in this package's lib/net10.0 group. This follows a custom output root
    without hard-coding a bin path and also works when packing after a normal build with `NoBuild=true`.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeGitLabClientModuleAssemblies</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="IncludeGitLabClientModuleAssemblies">
    <ItemGroup>
      <BuildOutputInPackage Include="$(TargetDir)GitLab.Client.Contracts.dll;$(TargetDir)GitLab.Client.Contracts.xml"/>
      <BuildOutputInPackage Include="$(TargetDir)GitLab.Client.Routing.dll;$(TargetDir)GitLab.Client.Routing.xml"/>
      <BuildOutputInPackage Include="$(TargetDir)GitLab.Client.Http.dll;$(TargetDir)GitLab.Client.Http.xml"/>
    </ItemGroup>
  </Target>

  <!--
    Publish CI intentionally reads the literal Version above before invoking dotnet pack. Keep that
    release-facing value, but fail packing if it diverges from the shared source-assembly version
    declared in src/Directory.Build.props. This prevents one nupkg from carrying module DLLs with
    mismatched assembly metadata while preserving the existing release gate.
  -->
  <Target Name="ValidateGitLabClientDistributionVersion" BeforeTargets="Pack">
    <PropertyGroup>
      <_GitLabClientEffectivePackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</_GitLabClientEffectivePackageVersion>
      <_GitLabClientEffectivePackageVersion Condition="'$(PackageVersion)' != ''">$(PackageVersion)</_GitLabClientEffectivePackageVersion>
    </PropertyGroup>

    <Error Condition="'$(_GitLabClientEffectivePackageVersion)' != '$(GitLabClientDistributionVersion)'"
           Text="GitLab.Client package version '$(_GitLabClientEffectivePackageVersion)' must match GitLabClientDistributionVersion '$(GitLabClientDistributionVersion)' in src/Directory.Build.props so all packaged assemblies share one version."/>
  </Target>

</Project>
