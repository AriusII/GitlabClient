<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

  <PropertyGroup>
    <!--
      The four assemblies placed in the single GitLab.Client package are compiled independently.
      Give every source project the same default Version so SDK-generated AssemblyVersion,
      FileVersion and InformationalVersion metadata cannot drift between the façade and its internal
      modules. The façade retains its literal Version for the release workflow, which validates that
      value before packing; its project file verifies the two values stay aligned at pack time.
    -->
    <GitLabClientDistributionVersion Condition="'$(GitLabClientDistributionVersion)' == ''">2.0.0</GitLabClientDistributionVersion>
    <Version Condition="'$(Version)' == ''">$(GitLabClientDistributionVersion)</Version>

    <!--
      Contracts, Routing and Http deliberately remain separate implementation assemblies, but they
      are implementation details of the one GitLab.Client NuGet distribution. New source projects
      are non-packable by default; the façade opts in explicitly and packs its module assemblies.
    -->
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Source emission is an opt-in diagnostic aid. Persisting thousands of generated sources on every
         normal build slows both local iteration and CI, while all generators remain active. -->
    <GitLabEmitGeneratedSources Condition="'$(GitLabEmitGeneratedSources)' == ''">false</GitLabEmitGeneratedSources>
    <EmitCompilerGeneratedFiles Condition="'$(GitLabEmitGeneratedSources)' == 'true'">true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath Condition="'$(GitLabEmitGeneratedSources)' == 'true'">obj\Generated</CompilerGeneratedFilesOutputPath>
    <!-- Failing fast on reflection JSON usage makes CoreCLR and Native AOT behave the same way. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup Condition="'$(GitLabEmitGeneratedSources)' == 'true'">
    <Compile Remove="obj\Generated\**\*.cs"/>
  </ItemGroup>

</Project>
